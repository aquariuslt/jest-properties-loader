{
  "name": "jest-properties-loader",
  "version": "1.0.8",
  "description": "jest properties loader for `.properties` file",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aquariuslt/jest-properties-loader.git"
  },
  "author": "aquariuslt <superaquariuslt@gmail.com>",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "test": "jest",
    "test:cov": "jest --coverage",
    "changeset": "changeset",
    "release": "changeset publish --access public"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "properties": "^1.2.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@types/jest": "^29.0.0",
    "@types/node": "^22.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "moduleFileExtensions": ["ts", "js", "json"],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testMatch": ["<rootDir>/src/**/*.test.ts"],
    "testEnvironment": "node",
    "coverageDirectory": "<rootDir>/reports/coverage"
  },
  "packageManager": "pnpm@10.31.0+sha512.e3927388bfaa8078ceb79b748ffc1e8274e84d75163e67bc22e06c0d3aed43dd153151cbf11d7f8301ff4acb98c68bdc5cadf6989532801ffafe3b3e4a63c268"
}
